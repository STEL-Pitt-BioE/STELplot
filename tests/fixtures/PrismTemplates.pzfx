<d>13</d>
<d>79</d>
</Subcolumn>
<Subcolumn>
<d>91</d>
<d>29</d>
<d>121</d>
</Subcolumn>
<Subcolumn>
<d>91</d>
<d>29</d>
<d>121</d>
</Subcolumn>
</YColumn>
</Table>
