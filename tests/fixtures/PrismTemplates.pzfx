<d>5.2</d>
<d>4.5</d>
<d>3.1</d>
<d>5</d>
</Subcolumn>
</YColumn>
<YColumn Width="70" Decimals="1" Subcolumns="1">
<Title>Treated</Title>
<Subcolumn>
<d>4.2</d>
<d>7.8</d>
<d>5.9</d>
<d>6.4</d>
<d>7.6</d>
</Subcolumn>
</YColumn>
</Table>
